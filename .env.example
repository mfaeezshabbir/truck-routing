# ---- backend (backend/.env or host env vars) ----
# OpenRouteService key (https://openrouteservice.org/dev/#/signup). If unset, the OSRM public demo server is used.
ORS_API_KEY=
# Unset = random per-process key (fine: no sessions/auth). Debug is off unless DJANGO_DEBUG=1 (use it locally).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Shared cache directory for all workers on a host (default: OS temp dir)
CACHE_DIR=
ALLOWED_HOSTS=*
# Comma-separated; empty = allow all origins
CORS_ALLOWED_ORIGINS=
# Sent to Nominatim / Open-Meteo / OSRM (Nominatim usage policy requires an identifying UA)
HTTP_USER_AGENT=spotter-truck-routing/1.0 (https://github.com/<you>/spotter-truck-routing)

# ---- frontend (frontend/.env) ----
VITE_API_BASE=
